+// Prepare row zero in the original column order. Only owned variants are immutable
+// scalars. A numeric view, even with stride zero, can alias writable storage.
+class correction::detail::PluginBatchRow {
+public:
+  PluginBatchRow(const std::vector<BatchInput>& inputs, size_t rows)
+    : values_(inputs.size()) {
+    for (size_t column = 0; column < inputs.size(); ++column)
+      values_[column] = inputs[column].at(0);
+    if (rows == 1) return;
+    varying_.reserve(inputs.size());
+    for (size_t column = 0; column < inputs.size(); ++column) {
+      if (!std::holds_alternative<Variable::Type>(inputs[column].data_))
+        varying_.push_back({&inputs[column], &values_[column]});
+    }
+  }
+  void advance(size_t row) {
+    for (const auto& column : varying_)
+      *column.value = column.input->at(row);
+  }
+  const std::vector<Variable::Type>& values() const { return values_; }
+
+private:
+  struct Column {
+    const BatchInput* input;
+    Variable::Type* value;
+  };
+  std::vector<Variable::Type> values_;
+  std::vector<Column> varying_;
+};
