+        self.call("jets_unsigned_pair_begin_state")
+        completed = False
+        try:
+            values = evaluator(*args)
+            completed = True
+            return values
+        finally:
+            self.call("jets_unsigned_pair_end_state", int(completed))
+
+    def discard(self):
+        self.call("jets_unsigned_pair_discard")
